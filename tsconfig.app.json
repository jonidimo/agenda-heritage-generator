{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@core/*": ["./src/core/*"] }
  },
  "include": ["src/app/**/*.ts", "src/app/**/*.tsx", "src/types/**/*.d.ts", "src/core/**/*.ts"]
}
