{
  "name": "agenda-heritage-studio",
  "version": "2.0.0",
  "private": true,
  "description": "Estudio para diseñar, previsualizar e imprimir agendas artesanales en cuadernillos (cualquier año, idioma y país).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "agenda": "tsx src/cli/agenda.ts",
    "pdf": "tsx src/cli/agenda.ts pdf",
    "holidays": "tsx scripts/build-holidays.ts",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "predev": "tsx scripts/build-holidays.ts --if-missing",
    "prebuild": "tsx scripts/build-holidays.ts --if-missing",
    "pretest": "tsx scripts/build-holidays.ts --if-missing",
    "preagenda": "tsx scripts/build-holidays.ts --if-missing",
    "prepdf": "tsx scripts/build-holidays.ts --if-missing"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "date-holidays-parser": "^3.4.7",
    "fontkit": "^2.0.4",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.9",
    "lucide-react": "^1.67.0",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "date-holidays": "^3.38.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
