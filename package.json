{
  "name": "agenda-heritage-studio",
  "version": "2.3.0",
  "private": true,
  "homepage": "https://github.com/jonidimo/agenda-heritage-generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonidimo/agenda-heritage-generator.git"
  },
  "bugs": {
    "url": "https://github.com/jonidimo/agenda-heritage-generator/issues"
  },
  "description": "Design, preview and print handmade planners in signatures, for any year, language and country.",
  "type": "module",
  "main": "electron/main.mjs",
  "desktopName": "agenda-heritage-studio.desktop",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "build:mcp": "tsx scripts/build-mcp.ts",
    "build:desktop": "npm run build && npm run build:mcp",
    "desktop:build": "npm run build:desktop && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.electron.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "agenda": "tsx src/cli/agenda.ts",
    "pdf": "tsx src/cli/agenda.ts pdf",
    "mcp": "tsx src/mcp/main.ts",
    "premcp": "tsx scripts/build-holidays.ts --if-missing 1>&2",
    "holidays": "tsx scripts/build-holidays.ts",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "predev": "tsx scripts/build-holidays.ts --if-missing",
    "prebuild": "tsx scripts/build-holidays.ts --if-missing",
    "pretest": "tsx scripts/build-holidays.ts --if-missing",
    "preagenda": "tsx scripts/build-holidays.ts --if-missing",
    "prepdf": "tsx scripts/build-holidays.ts --if-missing"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "fontkit": "^2.0.4",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.9",
    "lucide-react": "^1.67.0",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/vite": "^4.3.4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "date-holidays": "^3.38.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "author": "Jonatan <jonidimo@gmail.com>"
}
