{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "paths": { "@core/*": ["./src/core/*"] }
  },
  "include": ["src/cli/**/*.ts", "src/node/**/*.ts", "src/mcp/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "e2e/**/*.ts", "src/types/**/*.d.ts", "src/core/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.electron.config.ts"],
  "exclude": ["tests/app/**"]
}
